#!/usr/bin/env bash

usage() {
	echo "Usage: $(basename "$0") [-h] [-A] composeName..."
	echo " -h show this help"
	echo " -A remove all applications"
}
while getopts "hA" arg; do
	case $arg in
	h)
		usage
		exit 0
		;;
	A)
		down_all=true
		;;
	*)
		usage
		exit 1
		;;
	esac
done
shift $((OPTIND - 1))
if [[ $# -eq 0 && -z $down_all ]]; then
	usage
	exit 0
fi

ele_home=$(ele-config .cluster.home)
ele_project=$(ele-config .cluster.project)
if [[ -z $ele_home ]]; then
	echo "Cluster home is not set. Please set it using 'ele-config-set .cluster.home <path>'" 2>&1
	exit 1
fi
if [[ ! -d $ele_home ]]; then
	echo "Cluster home directory does not exist. ($ele_home)" 2>&1
	exit 1
fi
if [[ -z $ele_project ]]; then
	echo "Cluster Project is not set. Please set it using 'ele-config-set .cluster.project <project>'" 2>&1
	exit 1
fi

compose_names=()

if [[ $down_all == true ]]; then
	mapfile -t compose_names < <(/usr/lib/ele/list-compose-running.sh)
else
	compose_names=("$@")
fi

options=()
options+=(--project-name "$ele_project")

# Add --env-file for each file found in $ele_home/env
if [[ -d "$ele_home/env" ]]; then
	while IFS= read -r envfile; do
		options+=(--env-file="$envfile")
	done < <(find "$ele_home/env" -type f)
fi

for FILE in "${compose_names[@]}"; do

	compose_file=$(/usr/lib/ele/get-path-compose.sh "$FILE")

	if [[ ! -f $compose_file ]]; then
		echo "Compose file not exists for $FILE. ($compose_file)" 2>&1
	else
		env_file=$(dirname "$compose_file")/.env
		compose_options=()
		if [[ -f $env_file ]]; then
			compose_options+=(--env-file="$env_file")
		fi

		(
			set -x
			docker compose "${options[@]}" "${compose_options[@]}" -f "$compose_file" down
		)
	fi
done
