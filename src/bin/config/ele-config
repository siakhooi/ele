#!/bin/bash

usage() {
  echo "Usage: $(basename "$0") [-h] [yaml_path]"
}
while getopts "h" arg; do
  case $arg in
  h)
    usage
    exit 0
    ;;
  *)
    usage
    exit 1
    ;;
  esac
done
shift $((OPTIND - 1))
if [[ $# -ne 0 ]] && [[ $# -ne 1 ]]; then
  usage
  exit 0
fi

readonly config_file="$HOME/.ele/config.yaml"
readonly yaml_path=$1

if [[ -f "$config_file" ]]; then
  if [[ $# -eq 0 ]]; then
    yq "$config_file"
  elif [[ $# -eq 1 ]]; then
    yq "$yaml_path"' // ""' "$config_file"
  fi
fi
