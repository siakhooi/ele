#!/bin/bash

usage() {
	echo "Usage: $(basename "$0") [-h]"
}
while getopts "h" arg; do
	case $arg in
	h)
		usage
		exit 0
		;;
	*)
		usage
		exit 1
		;;
	esac
done
shift $((OPTIND - 1))
if [[ $# -ne 0 ]]; then
	usage
	exit 0
fi

readonly config_file="$HOME/.ele/config.yaml"

if [[ ! -f $config_file ]]; then
	mkdir -p "$(dirname "$config_file")"
	touch "$config_file"
fi

${EDITOR:-vi} "$config_file"
